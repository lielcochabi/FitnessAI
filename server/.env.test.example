# Copy this file to .env.test (already gitignored - see .gitignore's
# ".env.*" rule) before running `pytest` locally.
#
# This is used ONLY for local test runs, to keep tests from ever touching
# the real database in .env. It is not used in CI - the GitHub Actions
# workflow sets MONGODB_URI directly to its own ephemeral mongo service
# container instead (see .github/workflows/ci.yml).
#
# Quick local setup:
#   docker run -d -p 27017:27017 mongo:7

MONGODB_URI=mongodb://localhost:27017
