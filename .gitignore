# --- Python cache ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Virtual environments ---
.env
.venv
env/
venv/

# --- Streamlit cache & logs ---
# Ignore real secrets but keep committable config / *.example files.
**/.streamlit/secrets.toml
logs/
cache/

# --- DSPy / LLM temp artifacts ---
*.dspy_cache
*.cache

# --- OS / Editor garbage ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Environment variable files (NEVER commit keys) ---
# Same pattern as the Streamlit section above: ignore real secrets but keep
# committable *.example templates.
*.env
.env.*
!*.env.example
!.env.*.example

# --- Kubernetes secrets (NEVER commit real values) ---
deploy/secret.yaml

